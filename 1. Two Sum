class Solution {
    public int[] twoSum(int[] nums, int target) {
        Map<Integer,Integer> mp=new HashMap<>();
    for(int i=0;i<nums.length;i++)
    {
    int pair=target-nums[i];
    if(mp.containsKey(pair))
    {
        return new int[]{mp.get(pair),i};
    }
    mp.put(nums[i], i);
    }
    return new int[]{};
}
}
